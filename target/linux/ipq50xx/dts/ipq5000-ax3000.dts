/*
 * Device Tree Source for Redmi AX3000
 * Based on IPQ5018 SoC
 * For Linux 6.6
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Redmi AX3000";
	compatible = "redmi,ax3000", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;

		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x10000000>; /* 256MB RAM */
	};

	reserved-memory {
		tz_apps: tz_apps@4a400000 {
			no-map;
			reg = <0x0 0x4a400000 0x0 0x700000>;
		};

		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
			reg = <0x0 0x4b000000 0x0 0x3000000>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		mesh {
			label = "mesh";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system_blue: system-blue {
			label = "blue:system";
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_system_yellow: system-yellow {
			label = "yellow:system";
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
		};

		internet-blue {
			label = "blue:internet";
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		internet-yellow {
			label = "yellow:internet";
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart1 {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "0:mibib";
				reg = <0x100000 0x100000>;
				read-only;
			};

			partition@200000 {
				label = "0:bootconfig";
				reg = <0x200000 0x100000>;
				read-only;
			};

			partition@300000 {
				label = "0:bootconfig1";
				reg = <0x300000 0x100000>;
				read-only;
			};

			partition@400000 {
				label = "0:qsee";
				reg = <0x400000 0x200000>;
				read-only;
			};

			partition@600000 {
				label = "0:qsee_1";
				reg = <0x600000 0x200000>;
				read-only;
			};

			partition@800000 {
				label = "0:devcfg";
				reg = <0x800000 0x100000>;
				read-only;
			};

			partition@900000 {
				label = "0:devcfg_1";
				reg = <0x900000 0x100000>;
				read-only;
			};

			partition@a00000 {
				label = "0:apdp";
				reg = <0xa00000 0x100000>;
				read-only;
			};

			partition@b00000 {
				label = "0:apdp_1";
				reg = <0xb00000 0x100000>;
				read-only;
			};

			partition@c00000 {
				label = "0:rpm";
				reg = <0xc00000 0x100000>;
				read-only;
			};

			partition@d00000 {
				label = "0:rpm_1";
				reg = <0xd00000 0x100000>;
				read-only;
			};

			partition@e00000 {
				label = "0:cdt";
				reg = <0xe00000 0x100000>;
				read-only;
			};

			partition@f00000 {
				label = "0:cdt_1";
				reg = <0xf00000 0x100000>;
				read-only;
			};

			partition@1000000 {
				label = "0:appsbl";
				reg = <0x1000000 0x200000>;
				read-only;
			};

			partition@1200000 {
				label = "0:appsbl_1";
				reg = <0x1200000 0x200000>;
				read-only;
			};

			partition@1400000 {
				label = "0:art";
				reg = <0x1400000 0x100000>;
				read-only;
			};

			partition@1500000 {
				label = "0:art_1";
				reg = <0x1500000 0x100000>;
				read-only;
			};

			partition@1600000 {
				label = "0:tricolor";
				reg = <0x1600000 0x100000>;
				read-only;
			};

			partition@1700000 {
				label = "0:tricolor_1";
				reg = <0x1700000 0x100000>;
				read-only;
			};

			partition@1800000 {
				label = "0:factory";
				reg = <0x1800000 0x1400000>;
				read-only;
			};

			partition@2c00000 {
				label = "rootfs";
				reg = <0x2c00000 0x5400000>;
			};

			partition@8000000 {
				label = "rootfs_1";
				reg = <0x8000000 0x5400000>;
			};

			partition@d400000 {
				label = "0:wififw";
				reg = <0xd400000 0x100000>;
				read-only;
			};

			partition@d500000 {
				label = "0:wififw_1";
				reg = <0xd500000 0x100000>;
				read-only;
			};
		};
	};
};

&mdio {
	status = "okay";
};

&dp1 {
	status = "okay";
};

&dp2 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&wifi0 {
	status = "okay";

	qca,board_id = <0x24>;
	qca,ath11k-fw-memory-mode = <2>;
};

&wifi1 {
	status = "okay";

	qca,board_id = <0x60>;
	qca,ath11k-fw-memory-mode = <2>;
};
